pipeline {
    agent any
    options {
        disableConcurrentBuilds(abortPrevious: true) 
    }
    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select environment'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: false,
            description: 'Deploy application?'
        )
    }

    stages {
        stage('Deploy') {
            steps {
                echo "Environment: ${params.ENV}"
                echo "Deploy: ${params.DEPLOY}"
            }
        }
    }
}